  "author": "boredenchilada (https://github.com/boredchilada)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": { "npmtastic": "./dist/bin.js", "ntc": "./dist/bin.js" },
  "main": "./dist/index.js",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
